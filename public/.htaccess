# MIME types for modern image formats (some Apache versions omit these)
<IfModule mod_mime.c>
  AddType image/jpeg .jpg .jpeg
  AddType image/png  .png
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

# Never cache index.html so the browser always loads the latest hashed bundle
# (the JS/CSS under assets/ are content-hashed, so they can be cached forever).
<IfModule mod_headers.c>
  <FilesMatch "(^index\.html|service-worker\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Configurações para Hostinger + PHP API
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Permitir CORS
  Header always set Access-Control-Allow-Origin "*"
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization"

  # Pass Authorization header to PHP (stripped by Apache on shared hosting by default)
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Keep API routes intact — explicit pass-through BEFORE SPA fallback
  RewriteRule ^api/ - [L]

  # ── Public creative/asset delivery (Meta / partner crawlers) ────────────────
  # Image & video files under /projects/** are creative assets that external
  # partners (e.g. the Meta Graph API's facebookexternalhit crawler) fetch
  # anonymously — no cookie, no session. They MUST be served as the raw bytes
  # with the right Content-Type and NEVER fall through to the SPA shell, which
  # would return the React login page (HTTP 200 + text/html). Meta then rejects
  # the URL with "Only photo or video can be accepted as media type".
  #
  # 1) File exists  -> serve it directly and stop (no SPA, no login, 200 + MIME).
  RewriteCond %{REQUEST_URI} ^/projects/.+\.(jpe?g|png|webp|avif|gif|mp4|webm)$ [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  # 2) File missing -> return a REAL 404, never the login HTML. An external
  #    fetcher must get a clean failure for a creative URL, not a 200 web page.
  RewriteCond %{REQUEST_URI} ^/projects/.+\.(jpe?g|png|webp|avif|gif|mp4|webm)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # Hosted pages (generated LPs / ad creatives) are REAL folders with their own
  # index.html. Serve those directly instead of the SPA shell — otherwise the
  # rule below would hijack /projects/<slug>/ to the app (blank/looping preview).
  # App routes (/projects, /projects/new, /projects/123, /history…) are NOT real
  # folders with an index.html, so they still fall through to the SPA fallback.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # Known SPA routes — only redirect to app shell if the path is NOT a real file on disk.
  # This allows /projects/slug/b0/image.png (and other static assets) to be served directly.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(projects|history|ad-creatives|visual-editor|ads-editor|admin)(/.*)?$ /index.html [L]

  # Redirect everything else to index.html (SPA)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Segurança
<Files *.php>
  # Bloquear acesso direto aos arquivos PHP (exceto API)
  Order Deny,Allow
  Deny from all
  Allow from all
</Files>

# Configurações PHP
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value memory_limit 256M
php_value max_execution_time 300
