# Template das credenciais FTP do SERVER LIVE (producao) para scripts/deploy-live.ps1.
# Copie para .deploy.live.env (gitignorado) e preencha. APENAS para a API externa.
FTP_HOST=host_do_server_live
FTP_USER=usuario_ftp_live
FTP_PASS=senha_ftp_live
# Opcional: subpasta remota base, se a API externa nao ficar na raiz do FTP.
# REMOTE_BASE=public_html
